# Copy to .env.local for local dev; set the same two vars in Vercel for production.
# Both come from your Supabase project: Dashboard → Settings → API.
# Cloud sync is optional — with these unset the app runs fully local, exactly as before.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
