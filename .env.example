# Copy to .env.local for local dev; set the same vars in Vercel for production.
# The Supabase values come from Dashboard → Settings → API.
# Cloud sync is optional — with these unset the app runs fully local, exactly as before.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Exact production return URL for Google OAuth. Add this URL (including
# ?auth=return) to Supabase Authentication → URL Configuration → Redirect URLs.
VITE_SITE_URL=https://ssbm-dashboard.vercel.app

# For branded OAuth, VITE_SUPABASE_URL may instead be your activated Supabase
# custom domain, e.g. https://auth.your-domain.com. Also allow that hostname in
# vercel.json's connect-src and add its /auth/v1/callback URL in Google Cloud.
