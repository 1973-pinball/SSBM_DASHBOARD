#!/bin/sh
# Every commit in this repo is authored and committed as the project identity
# below. This refuses to push anything else, so a machine with a stray global
# git config can't quietly attach a different address to the public history.
#
# Enabled per clone (git never runs tracked hooks automatically):
#     git config core.hooksPath .githooks
# Bypass once, deliberately, with: git push --no-verify
ALLOWED='info.studio.pinball@gmail.com'
BOT='41898282+github-actions[bot]@users.noreply.github.com'
ZERO='0000000000000000000000000000000000000000'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$ZERO" ] && continue
	if [ "$remote_sha" = "$ZERO" ]; then
		revs=$(git rev-list "$local_sha" --not --remotes)
	else
		revs=$(git rev-list "$remote_sha..$local_sha")
	fi
	for c in $revs; do
		for e in $(git log -1 --format='%ae%n%ce' "$c" | sort -u); do
			if [ "$e" != "$ALLOWED" ] && [ "$e" != "$BOT" ]; then
				echo "pre-push: BLOCKED $(git log -1 --format='%h %s' "$c")" >&2
				echo "          email '$e' is not the project identity" >&2
				status=1
			fi
		done
	done
done

if [ $status -ne 0 ]; then
	echo "" >&2
	echo "Fix with: git config user.email $ALLOWED" >&2
	echo "then amend or rebase the offending commits before pushing." >&2
fi
exit $status
